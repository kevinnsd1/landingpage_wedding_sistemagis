# ==============================================================================
# KisahMagis — Monorepo .gitignore
# ==============================================================================

# Node & Dependency Directories
node_modules/
*/node_modules/
.pnp/
.pnp.js

# Build Outputs & Bundles
dist/
**/dist/
build/
**/build/
out/
**/out/
.vite/
**/.vite/
.vite-temp/
**/.vite-temp/

# TypeScript Build Info & Cache
*.tsbuildinfo
**/*.tsbuildinfo

# Environment & Sensitive Credentials (NEVER commit secrets or live DB URLs)
.env
.env.*
!.env.example
apps/*/.env
apps/*/.env.*
!apps/*/.env.example

# Logs & Runtime Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Testing & Coverage Reports
coverage/
.nyc_output/
*.lcov

# Temporary, Cache & Turborepo
.cache/
.turbo/
.parcel-cache/
temp/
tmp/
