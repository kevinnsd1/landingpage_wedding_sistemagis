# ==============================================================================
# KisahMagis — Git Attributes & Line Ending Configuration
# ==============================================================================

# Default behavior: auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.ts            text diff=typescript eol=lf
*.tsx           text diff=typescript eol=lf
*.js            text diff=javascript eol=lf
*.jsx           text diff=javascript eol=lf
*.mjs           text diff=javascript eol=lf
*.cjs           text diff=javascript eol=lf
*.json          text eol=lf
*.css           text diff=css eol=lf
*.scss          text diff=css eol=lf
*.html          text diff=html eol=lf
*.md            text diff=markdown eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sql           text eol=lf
*.env.example   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Windows scripts (preserve CRLF if needed, or LF for cross-platform)
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Shell scripts (must always be LF)
*.sh            text eol=lf

# Binary media files (prevent Git from modifying bytes or line endings)
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.svg           text eol=lf
*.pdf           binary

# Fonts
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary
*.otf           binary

# Archives & binaries
*.zip           binary
*.tar.gz        binary
*.tgz           binary
